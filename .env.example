# Path on the host where your Ollama models already live.
# This is a bind mount, not a copy - the container reads/writes directly here,
# so models you've already pulled are used as-is and any new pulls land here too.
OLLAMA_MODELS_PATH=D:/ollama/Models

# Port exposed on localhost
OLLAMA_PORT=11434

# Port for the chat UI
UI_PORT=3000

# Context window (tokens) each model keeps per conversation.
# Higher = the model "remembers" more of a long chat, but uses more VRAM.
OLLAMA_CONTEXT_LENGTH=8192

# How long an idle model stays loaded in VRAM before unloading, e.g. "30m".
# -1 = never unload. Set a real duration instead if you'd rather free VRAM
# for other apps between uses, at the cost of a reload delay on the next request.
OLLAMA_KEEP_ALIVE=-1

# Postgres credentials for the local-llm-db container, which stores chat
# history, project registrations, and usage logs. Local-only (not exposed to
# the host), so these are just internal defaults, not real secrets - change
# them if you want, but there's no need to.
POSTGRES_DB=localllm
POSTGRES_USER=localllm
POSTGRES_PASSWORD=localllm
